{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-external-operator-reproduction-audit.schema.json",
  "title": "AOF External Operator Reproduction Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "artifact_type",
    "generated_at",
    "project_root",
    "summary",
    "records",
    "checks",
    "errors"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "external-operator-reproduction-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "go_count",
        "reproducible_count",
        "timebox_pass_count",
        "failing_check_count"
      ],
      "properties": {
        "record_count": { "type": "integer", "minimum": 0 },
        "go_count": { "type": "integer", "minimum": 0 },
        "reproducible_count": { "type": "integer", "minimum": 0 },
        "timebox_pass_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "work_item_id",
          "selected_task_id",
          "operator_profile_id",
          "decision",
          "operator_can_reproduce",
          "artifact_ref"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "work_item_id": { "type": "string" },
          "selected_task_id": { "type": "string" },
          "operator_profile_id": { "type": "string" },
          "decision": { "type": "string" },
          "operator_can_reproduce": { "type": "boolean" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
