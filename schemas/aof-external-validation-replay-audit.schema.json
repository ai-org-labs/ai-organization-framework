{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-external-validation-replay-audit.schema.json",
  "title": "AOF External Validation Replay Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "artifact_type",
    "generated_at",
    "project_root",
    "summary",
    "replays",
    "checks",
    "errors"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "external-validation-replay-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_count",
        "governance_escalation_count",
        "accepted_supporting_evidence_count",
        "external_write_attempt_count",
        "external_write_authorized_count",
        "failing_check_count"
      ],
      "properties": {
        "replay_count": { "type": "integer", "minimum": 0 },
        "governance_escalation_count": { "type": "integer", "minimum": 0 },
        "accepted_supporting_evidence_count": { "type": "integer", "minimum": 0 },
        "external_write_attempt_count": { "type": "integer", "minimum": 0 },
        "external_write_authorized_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "replays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replay_id", "validation_result", "confidence_delta", "governance_route", "decision", "artifact_ref"],
        "properties": {
          "replay_id": { "type": "string" },
          "validation_result": { "type": "string" },
          "confidence_delta": { "type": "string" },
          "governance_route": { "type": "string" },
          "decision": { "type": "string" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
