{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-agent-session-contract-audit.schema.json",
  "title": "AOF Agent Session Contract Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "artifact_type",
    "generated_at",
    "project_root",
    "summary",
    "sessions",
    "checks",
    "errors"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "agent-session-contract-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoped_task_count",
        "session_count",
        "runtime_ready_session_count",
        "tool_call_count",
        "governed_tool_call_count",
        "failing_check_count"
      ],
      "properties": {
        "scoped_task_count": { "type": "integer", "minimum": 0 },
        "session_count": { "type": "integer", "minimum": 0 },
        "runtime_ready_session_count": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "governed_tool_call_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "session_ref",
          "source_task_id",
          "event_count",
          "tool_call_count",
          "release_verdict"
        ],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "session_ref": { "type": "string", "minLength": 1 },
          "source_task_id": { "type": "string", "minLength": 1 },
          "event_count": { "type": "integer", "minimum": 0 },
          "tool_call_count": { "type": "integer", "minimum": 0 },
          "release_verdict": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
