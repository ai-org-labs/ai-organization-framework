{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-provider-read-integration-audit.schema.json",
  "title": "AOF Provider Read Integration Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "artifact_type",
    "generated_at",
    "project_root",
    "summary",
    "integrations",
    "checks",
    "errors"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "provider-read-integration-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_count",
        "live_read_count",
        "go_count",
        "external_write_attempt_count",
        "external_write_authorized_count",
        "failing_check_count"
      ],
      "properties": {
        "integration_count": { "type": "integer", "minimum": 0 },
        "live_read_count": { "type": "integer", "minimum": 0 },
        "go_count": { "type": "integer", "minimum": 0 },
        "external_write_attempt_count": { "type": "integer", "minimum": 0 },
        "external_write_authorized_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["integration_id", "provider", "repository", "read_mode", "decision", "artifact_ref"],
        "properties": {
          "integration_id": { "type": "string" },
          "provider": { "type": "string" },
          "repository": { "type": "string" },
          "read_mode": { "type": "string" },
          "decision": { "type": "string" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
