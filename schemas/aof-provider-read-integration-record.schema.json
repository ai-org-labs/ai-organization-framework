{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-provider-read-integration-record.schema.json",
  "title": "AOF Provider Read Integration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "integration_id",
    "recorded_at",
    "provider",
    "repository",
    "adapter_ref",
    "resource_ref",
    "read_mode",
    "read_authority_boundary",
    "write_authority_boundary",
    "side_effect_boundary",
    "freshness_boundary",
    "external_read_commands",
    "observed_objects",
    "output_summary",
    "external_write_attempted",
    "external_write_authorized",
    "selected_decision",
    "evidence_refs",
    "not_proven",
    "source_task_id",
    "source_parent_session_id"
  ],
  "properties": {
    "artifact_type": { "const": "provider-read-integration-record" },
    "integration_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "adapter_ref": { "type": "string", "minLength": 1 },
    "resource_ref": { "type": "string", "minLength": 1 },
    "read_mode": { "type": "string", "enum": ["read_only", "read_only_live", "read_only_cached"] },
    "read_authority_boundary": { "type": "string", "minLength": 1 },
    "write_authority_boundary": { "type": "string", "minLength": 1 },
    "side_effect_boundary": { "type": "string", "minLength": 1 },
    "freshness_boundary": { "type": "string", "minLength": 1 },
    "external_read_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "operation_type", "result_state"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "operation_type": { "type": "string", "enum": ["read"] },
          "result_state": { "type": "string", "enum": ["observed", "empty", "failed"] },
          "summary": { "type": "string" }
        }
      }
    },
    "observed_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_metadata", "latest_release", "open_issues", "open_pull_requests", "workflow_runs"],
      "properties": {
        "repo_metadata": { "type": "object" },
        "latest_release": { "type": "object" },
        "open_issues": { "type": "array" },
        "open_pull_requests": { "type": "array" },
        "workflow_runs": { "type": "array" }
      }
    },
    "output_summary": { "type": "string", "minLength": 1 },
    "external_write_attempted": { "const": false },
    "external_write_authorized": { "const": false },
    "selected_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "next_action"],
      "properties": {
        "decision": { "type": "string", "enum": ["go", "no_go", "defer", "blocked"] },
        "rationale": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "not_proven": { "type": "string", "minLength": 1 },
    "source_task_id": { "type": "string", "minLength": 1 },
    "source_parent_session_id": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] }
  }
}
