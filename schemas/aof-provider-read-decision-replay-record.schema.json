{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-provider-read-decision-replay-record.schema.json",
  "title": "AOF Provider Read Decision Replay Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "replay_id",
    "recorded_at",
    "provider_read_integration_ref",
    "provider_observation_replay_ref",
    "external_operator_feedback_ref",
    "decision_state",
    "feedback_route",
    "operator_summary",
    "why_this_decision",
    "what_changed",
    "mission_control_summary",
    "next_action",
    "evidence_refs",
    "not_proven",
    "source_task_id",
    "source_parent_session_id"
  ],
  "properties": {
    "artifact_type": { "const": "provider-read-decision-replay-record" },
    "replay_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "provider_read_integration_ref": { "type": "string", "minLength": 1 },
    "provider_observation_replay_ref": { "type": "string", "minLength": 1 },
    "external_operator_feedback_ref": { "type": "string", "minLength": 1 },
    "decision_state": { "type": "string", "enum": ["accepted", "blocked", "reopened", "deferred", "needs_review"] },
    "feedback_route": { "type": "string", "enum": ["accept_as_product_evidence", "request_clarification", "reopen_product_work", "block_release_claim", "defer"] },
    "operator_summary": { "type": "string", "minLength": 1 },
    "why_this_decision": { "type": "string", "minLength": 1 },
    "what_changed": { "type": "string", "minLength": 1 },
    "mission_control_summary": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "not_proven": { "type": "string", "minLength": 1 },
    "source_task_id": { "type": "string", "minLength": 1 },
    "source_parent_session_id": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] }
  }
}
