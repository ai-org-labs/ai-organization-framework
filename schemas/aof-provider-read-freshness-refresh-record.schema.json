{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-provider-read-freshness-refresh-record.schema.json",
  "title": "AOF Provider Read Freshness Refresh Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "refresh_id",
    "recorded_at",
    "provider_read_decision_replay_ref",
    "provider_read_integration_ref",
    "observation_ref",
    "original_observed_at",
    "refreshed_at",
    "max_age_hours",
    "freshness_status",
    "refresh_decision",
    "operator_summary",
    "next_action",
    "evidence_refs",
    "not_proven",
    "source_task_id",
    "source_parent_session_id"
  ],
  "properties": {
    "artifact_type": { "const": "provider-read-freshness-refresh-record" },
    "refresh_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "provider_read_decision_replay_ref": { "type": "string", "minLength": 1 },
    "provider_read_integration_ref": { "type": "string", "minLength": 1 },
    "observation_ref": { "type": "string", "minLength": 1 },
    "original_observed_at": { "type": "string", "format": "date-time" },
    "refreshed_at": { "type": "string", "format": "date-time" },
    "max_age_hours": { "type": "integer", "exclusiveMinimum": 0 },
    "freshness_status": { "type": "string", "enum": ["current", "stale", "expired", "unknown"] },
    "refresh_decision": { "type": "string", "enum": ["use_as_current", "require_refresh", "block_reuse", "defer"] },
    "operator_summary": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "not_proven": { "type": "string", "minLength": 1 },
    "source_task_id": { "type": "string", "minLength": 1 },
    "source_parent_session_id": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] }
  }
}
