{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-github-readonly-observation-audit.schema.json",
  "title": "AOF GitHub Read-Only Observation Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "artifact_type",
    "generated_at",
    "project_root",
    "summary",
    "observations",
    "checks",
    "errors"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "github-readonly-observation-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_count",
        "ready_observation_count",
        "selected_task_count",
        "external_write_authorized_count",
        "failing_check_count"
      ],
      "properties": {
        "observation_count": { "type": "integer", "minimum": 0 },
        "ready_observation_count": { "type": "integer", "minimum": 0 },
        "selected_task_count": { "type": "integer", "minimum": 0 },
        "external_write_authorized_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "work_item_id",
          "repository",
          "selected_task_id",
          "go_no_go",
          "artifact_ref"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "work_item_id": { "type": "string" },
          "repository": { "type": "string" },
          "selected_task_id": { "type": "string" },
          "go_no_go": { "type": "string" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
