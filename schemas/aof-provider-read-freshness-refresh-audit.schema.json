{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-org-labs.github.io/aof/schemas/aof-provider-read-freshness-refresh-audit.schema.json",
  "title": "AOF Provider Read Freshness Refresh Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "artifact_type", "generated_at", "project_root", "summary", "refreshes", "checks", "errors"],
  "properties": {
    "ok": { "type": "boolean" },
    "artifact_type": { "const": "provider-read-freshness-refresh-audit" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refresh_count", "current_count", "stale_count", "expired_count", "unknown_count", "blocked_reuse_count", "require_refresh_count", "failing_check_count"],
      "properties": {
        "refresh_count": { "type": "integer", "minimum": 0 },
        "current_count": { "type": "integer", "minimum": 0 },
        "stale_count": { "type": "integer", "minimum": 0 },
        "expired_count": { "type": "integer", "minimum": 0 },
        "unknown_count": { "type": "integer", "minimum": 0 },
        "blocked_reuse_count": { "type": "integer", "minimum": 0 },
        "require_refresh_count": { "type": "integer", "minimum": 0 },
        "failing_check_count": { "type": "integer", "minimum": 0 }
      }
    },
    "refreshes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refresh_id", "freshness_status", "refresh_decision", "max_age_hours", "refreshed_at", "operator_summary", "next_action", "artifact_ref"],
        "properties": {
          "refresh_id": { "type": "string" },
          "freshness_status": { "type": "string" },
          "refresh_decision": { "type": "string" },
          "max_age_hours": { "type": "integer" },
          "refreshed_at": { "type": "string" },
          "operator_summary": { "type": "string" },
          "next_action": { "type": "string" },
          "artifact_ref": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
